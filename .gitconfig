[user]
  email = hyeonmin.ha@friendli.ai
  name = Hyeonmin Ha
[alias]
  last = log -1 HEAD
  unstage = reset HEAD --
[core]
  editor = nvim
[diff]
  tool = vimdiff
[merge]
	tool = fugitive
[difftool]
  prompt = false
  trustExitCode = true
[difftool "vimdiff"]
  path = nvim
[mergetool "fugitive"]
  cmd = nvim -f -c "Gvdiffsplit!" "$MERGED"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[protocol "file"]
	allow = always
